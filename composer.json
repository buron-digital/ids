{
  "name": "buron-digital/ids",
  "description": "Working with value objects for ids in Symfony",
  "type": "symfony-bundle",
  "require": {
    "php": "8.5.*|8.6.*",
    "buron-digital/self-aware-normalizers": "^2.0.0",
    "doctrine/dbal": "^4.5.0",
    "symfony/framework-bundle": "^7.4|^8.0",
    "symfony/polyfill-uuid": "^1.31",
    "symfony/serializer": "^7.4|^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13.4",
    "vimeo/psalm": "^6.20"
  },
  "suggest": {
    "ext-uuid": "Improves performance of id creation and validation. symfony/polyfill-uuid is used as a fallback."
  },
  "autoload": {
    "psr-4": {
      "BuronDigital\\Ids\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BuronDigital\\Ids\\": "tests/"
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Christian Kolb",
      "email": "info@buron.digital"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
